# Supabase project for accounts (Project settings → API). Copy to .env.local and fill in.
# Leave unset and the site runs without accounts: the editor works as before, sign-in pages say "not set up yet".
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# the public anon key (or the newer publishable key, sb_publishable_…) — safe in the browser; never the service_role key
VITE_SUPABASE_ANON_KEY=

# The site's address (with its base path, no trailing slash) for canonical links, social cards and the sitemap.
# Set SITE_URL (or this) on the host that builds the site.
# VITE_SITE_URL=https://urbanplan-seven.vercel.app
